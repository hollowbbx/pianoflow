  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <!-- Compás 0: anacrusa de una negra (Sol4, dedo 5) -->
    <measure number="0" implicit="yes">
      <attributes>
        <divisions>2</divisions>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <staves>2</staves>
      </attributes>
      <direction><sound tempo="60"/></direction>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><staff>1</staff>
        <notations><technical><fingering>5</fingering></technical></notations></note>
      <backup><duration>2</duration></backup>
      <note><rest/><duration>2</duration><voice>5</voice><staff>2</staff></note>
    </measure>
    <!-- Compás 1: derecha Do4 ligada (blanca+negra) + Mi4; izquierda acorde Do3-Mi3-Sol3 redonda -->
    <measure number="1">
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>4</duration><tie type="start"/><voice>1</voice><staff>1</staff>
        <notations><technical><fingering>1</fingering></technical></notations></note>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>2</duration><tie type="stop"/><voice>1</voice><staff>1</staff></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><staff>1</staff>
        <notations><technical><fingering>3</fingering></technical></notations></note>
      <backup><duration>8</duration></backup>
      <note><pitch><step>C</step><octave>3</octave></pitch><duration>8</duration><voice>5</voice><staff>2</staff></note>
      <note><chord/><pitch><step>E</step><octave>3</octave></pitch><duration>8</duration><voice>5</voice><staff>2</staff></note>
      <note><chord/><pitch><step>G</step><octave>3</octave></pitch><duration>8</duration><voice>5</voice><staff>2</staff></note>
    </measure>
    <!-- Compás 2: tempo 120; derecha Fa#4 (alteración) y silencio; nota de adorno ignorada -->
    <measure number="2">
      <direction><sound tempo="120"/></direction>
      <note><grace/><pitch><step>A</step><octave>4</octave></pitch><voice>1</voice><staff>1</staff></note>
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>4</duration><voice>1</voice><staff>1</staff></note>
